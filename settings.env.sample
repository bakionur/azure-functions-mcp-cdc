# ─────────────────────────────────────────────────────────────────────────────
# CDC-Germany 2026 demo · ONE settings file for everything.
#   cp settings.env.sample settings.env      # settings.env is gitignored — secrets stay local
#   ./scripts/up.ps1                         # (or ./scripts/up.sh) reads settings.env, deploys, smoke-tests
#   ./scripts/apply-settings.ps1 -Provision  # after changing a value on an existing deployment
# Format: KEY=value, one per line, no quotes. Empty value = "not used / default".
# ─────────────────────────────────────────────────────────────────────────────

# ── Azure target ─────────────────────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<your-tenant-id>
AZURE_ENV_NAME=cdc
# Functions, Foundry, APIM region. (API Center always goes to westeurope: not offered in germanywestcentral.)
AZURE_LOCATION=germanywestcentral

# ── Demo 3 · Azure DevOps (adopilot). Empty org/project = demo only whoami/Entra. ─
ADO_ORG_URL=https://dev.azure.com/<your-org>
ADO_PROJECT=<your-project>
# Team name; empty = "<project> Team"
ADO_TEAM=
# No PAT anywhere: adopilot calls ADO on behalf of the signed-in Entra user (org connected to AZURE_TENANT_ID)

# ── Demo 2 · SkyWatch radar centre (default: Congress Park Hanau) ────────────
HOME_LAT=50.1329
HOME_LON=8.9169

# ── Feature switches ─────────────────────────────────────────────────────────
# Built-in Entra auth on adopilot (needs the right to register apps in the tenant)
ENABLE_ENTRA_AUTH=true
ENABLE_API_CENTER=true
ENABLE_FOUNDRY=true
# APIM Basic v2 gateway in front of skywatch for the Foundry path (~€5/day while it exists)
ENABLE_APIM=false
# Required by APIM when enabled (shown as the API publisher)
APIM_PUBLISHER_EMAIL=
